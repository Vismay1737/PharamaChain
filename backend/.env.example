# PharmaChain Backend Configuration
SECRET_KEY=generate_a_secure_random_string_here
JWT_SECRET_KEY=generate_another_secure_random_string_here
DATABASE_URL=sqlite:///pharmachain.db

# MQTT Broker (Use 'mosquitto' if running in Docker, else 'localhost')
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here

# Blockchain (Ganache)
GANACHE_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=your_ganache_account_private_key
CONTRACT_ADDRESS=your_deployed_contract_address
